# Random secret >=32 characters. Never NEXT_PUBLIC.
SECURITY_HMAC_KEY=
# true only on Cloudflare, never on an untrusted proxy or public Node origin.
TRUST_CF_CONNECTING_IP=false
JOBS_SECRET=
# Authorized internal receiver; no WhatsApp automation.
